# Studio Operator local demo.
# Copy this file to .env (`npm run dev` does that automatically).
# Do not put real API keys in this file or in git.

# mock runs generation without API keys and never calls Higgsfield.
# live uses the REST adapter for SOUL V2 stills and Kling 3.0 Standard video
# when both credentials below are set. Other steps stay local previews.
STUDIO_OPERATOR_MODE=mock

# Analysis provider.
# Leave STUDIO_ANALYSIS_MODE empty: a non-empty OPENAI_API_KEY uses the
# OpenAI Responses API, and an empty key uses the local mock analysis.
# Set mock to force the local analysis even when a key is present.
STUDIO_ANALYSIS_MODE=

# SQLite file for the local demo. Persistence sits behind the job repository
# so this can move to Postgres later.
# Resolved relative to prisma/schema.prisma, so the file is prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Server-side only. The browser never receives this value.
# Model calls use the OpenAI Responses API with gpt-6-astra and Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Target gross margin used to size the production budget, in basis points.
# 2500 = 25%. Missing catalog prices route a job to human review.
TARGET_MARGIN_BPS=2500

# Optional aliases. OPENAI_API_KEY and OPENAI_MODEL take precedence.
OPENAI_COMPAT_MODEL=gpt-6-astra
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Higgsfield credentials. Server only. Do not put these in client code,
# logs, or screenshots. The official header is Authorization: Key KEY_ID:KEY_SECRET.
# HF_CREDENTIALS (KEY_ID:KEY_SECRET) is the TypeScript SDK's env name. This desk
# uses the two variables below with the documented REST API, because the
# published TS client does not expose estimate, cancel, and a separate timeout.
# A single HIGGSFIELD_API_KEY is not the current credential format.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# Stop polling after this many milliseconds and record desk status timed_out.
# The provider status is left as queued or in_progress. Default 180000.
HIGGSFIELD_POLL_TIMEOUT_MS=180000
