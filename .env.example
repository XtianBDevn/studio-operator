# Studio Operator local demo.
# Copy this file to .env (`npm run dev` does that automatically).
# Do not put real API keys in this file or in git.

# mock runs the full desk without API keys.
# live is reserved for a later prompt. In this build, live mode refuses
# before any network call.
STUDIO_OPERATOR_MODE=mock

# SQLite file for the local demo. Persistence sits behind the job repository
# so this can move to Postgres later.
# Resolved relative to prisma/schema.prisma, so the file is prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Analysis is labeled GPT-6 Astra. The model id is configurable.
# Prompt 1 does not call this endpoint. Leave the key empty.
OPENAI_COMPAT_MODEL=gpt-6-astra
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Higgsfield generation. Prompt 1 ships a mock catalog and a stub.
# The stub does not read the key and does not call the base URL.
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
